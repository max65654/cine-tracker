rules_version = '2';
// Règles Firestore de Mon Ciné Tracker (écrites d'après le code de index.html, V38).
// À coller dans Firebase → Firestore Database → Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // même liste que CINE_CLOUD.admins dans index.html
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in ['maxfenec@gmail.com'];
    }
    // compte validé par l'admin
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    // ---------- comptes (demande d'inscription → validation par l'admin) ----------
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      // on ne peut pas s'auto-valider : approved doit être false à la création (sauf l'admin)
      allow create: if isMe(uid) && (request.resource.data.approved == false || isAdmin());
      // l'utilisateur peut mettre à jour sa fiche sans toucher à « approved »
      allow update: if isAdmin()
        || (isMe(uid) && request.resource.data.approved == resource.data.approved);
      allow delete: if isAdmin();

      // sauvegarde de la collection, des réglages (dont les effets ✨ V38), etc.
      match /kv/{key} {
        allow read, write: if isMe(uid) || isAdmin();
      }
    }

    // ---------- réglages de l'appli (série Premium, maintenance) ----------
    // lisible par tous : l'écran de connexion vérifie la maintenance avant la connexion
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- profils publics des potes ----------
    match /pub/{uid} {
      allow read: if approved();
      allow write: if isMe(uid) && approved();
    }

    // ---------- qui est en ligne ----------
    match /presence/{uid} {
      allow read: if approved();
      allow write: if isMe(uid);
    }

    // ---------- fil d'activité ----------
    match /activity/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- recommandations entre potes ----------
    match /reco/{id} {
      allow read: if approved()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if approved() && request.resource.data.from == request.auth.uid;
      allow update: if approved() && resource.data.to == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ---------- chat ----------
    match /chat/{id} {
      allow read: if approved();
      allow create: if approved() && request.resource.data.uid == request.auth.uid;
      allow delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    // ---------- défis / quiz / tier lists à deux ----------
    match /battles/{id} {
      allow read: if approved()
        && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow create: if approved() && request.resource.data.a == request.auth.uid;
      allow update: if approved()
        && (resource.data.a == request.auth.uid || resource.data.b == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}
